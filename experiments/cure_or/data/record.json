{"created": "2020-12-01T03:03:22.841379+00:00", "modified": "2026-03-27T00:00:57.275640+00:00", "id": 4299330, "conceptrecid": "4268900", "doi": "10.5281/zenodo.4299330", "conceptdoi": "10.5281/zenodo.4268900", "doi_url": "https://doi.org/10.5281/zenodo.4299330", "metadata": {"title": "mini CURE-OR", "doi": "10.5281/zenodo.4299330", "publication_date": "2020-11-12", "description": "<p><strong>The webpage associated with this dataset can be found <a href=\"https://alregib.ece.gatech.edu/software-and-datasets/mini-cure-or-challenging-unreal-and-real-environments-for-object-recognition/\">here</a>.</strong></p>\n<p><strong>File descriptions</strong></p>\n<ul>\n<li><strong>train.zip&nbsp;</strong>- the training set</li>\n<li><strong>test.zip&nbsp;</strong>- the test set</li>\n<li><strong>train.csv</strong>&nbsp;- the ground truth for the training images with the following information:&nbsp;<em>imageID, class, background, perspective, challengeType, challengeLevel</em></li>\n<li><strong>test.csv</strong> - the ground truth for the training images with the following information: imageID, class, background, perspective, challengeType, challengeLevel</li>\n</ul>\n<p><strong>Data fields</strong></p>\n<ul>\n<li><strong>imageID&nbsp;</strong>- an anonymous id unique to a given image</li>\n<li><strong>class&nbsp;</strong>- the class of the object in the given image: 1-10\n<ul>\n<li>1: Canon camera</li>\n<li>2: Training marker cone</li>\n<li>3: Baseball</li>\n<li>4: Pan</li>\n<li>5: Toy</li>\n<li>6: LG Cell phone</li>\n<li>7: Hair brush</li>\n<li>8: DYMO Label maker</li>\n<li>9: Calcium bottle</li>\n<li>10: Shoes</li>\n</ul>\n</li>\n<li><strong>background&nbsp;</strong>- the background of the object\n<ul>\n<li>1: 2D white</li>\n<li>2: 2D living room</li>\n<li>3: 2D kitchen</li>\n</ul>\n</li>\n<li><strong>perspective&nbsp;</strong>- the perspective/orientation of the object\n<ul>\n<li>1: Front</li>\n<li>2: Left side - 90 degrees</li>\n<li>3: Back - 180 degrees</li>\n<li>4: Right side - 270 degrees</li>\n<li>5: Top</li>\n</ul>\n</li>\n<li><strong>challengeType&nbsp;</strong>- the type of generated challenging conditions\n<ul>\n<li>01: No challenge</li>\n<li>02: Resize</li>\n<li>03: Underexposure</li>\n<li>04: Overexposure</li>\n<li>05: Gaussian blur</li>\n<li>06: Contrast</li>\n<li>07: Dirty lens 1</li>\n<li>08: Dirty lens 2</li>\n<li>09: Salt &amp; pepper noise</li>\n<li>10: Grayscale</li>\n<li>11: Grayscale resize</li>\n<li>12: Grayscale underexposure</li>\n<li>13: Grayscale overexposure</li>\n<li>14: Grayscale gaussian blur</li>\n<li>15: Grayscale contrast</li>\n<li>16: Grayscale dirty lens 1</li>\n<li>17: Grayscale dirty lens 2</li>\n<li>18: Grayscale salt &amp; pepper noise</li>\n</ul>\n</li>\n<li><strong>challengeLevel&nbsp;</strong>- the level of generated challenging conditions\n<ul>\n<li>0: No challenge (01) and Grayscale (10) only - no challenge level</li>\n<li>1 - 4: the degree of a challenge from least to most</li>\n</ul>\n</li>\n</ul>", "access_right": "open", "creators": [{"name": "Dogancan Temel", "affiliation": "Georgia Institute of Technology"}, {"name": "Jinsol Lee", "affiliation": "Georgia Institute of Technology"}, {"name": "Ghassan AlRegib", "affiliation": "Georgia Institute of Technology"}], "keywords": ["object recognition", "object recognition dataset", "robustness", "challenging conditions", "machine learning", "deep learning"], "related_identifiers": [{"identifier": "10.1109/ICMLA.2018.00028", "relation": "isReferencedBy", "resource_type": "publication-conferencepaper", "scheme": "doi"}, {"identifier": "10.1109/ICIP.2019.8803317", "relation": "isReferencedBy", "resource_type": "publication-conferencepaper", "scheme": "doi"}], "references": ["D. Temel*, J. Lee*, and G. AlRegib, \"CURE-OR: Challenging Unreal and Real Environments for Object Recognition,\" in IEEE International Conference on Machine Learning and Applications (ICMLA), Orlando, FL, Dec. 2018", "D. Temel*, J. Lee*, and G. AlRegib, \"Object Recognition Under Multifarious Conditions: A Reliability Analysis and a Feature Similarity-Based Performance Estimation,\" in IEEE International Conference on Image Processing (ICIP), Taipei, Taiwan, Sep. 2019"], "resource_type": {"title": "Dataset", "type": "dataset"}, "license": {"id": "cc-by-4.0"}, "communities": [{"id": "olives_gatech"}], "relations": {"version": [{"index": 1, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "4268900"}}]}}, "title": "mini CURE-OR", "links": {"self": "https://zenodo.org/api/records/4299330", "self_html": "https://zenodo.org/records/4299330", "preview_html": "https://zenodo.org/records/4299330?preview=1", "doi": "https://doi.org/10.5281/zenodo.4299330", "self_doi": "https://doi.org/10.5281/zenodo.4299330", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.4299330", "reserve_doi": "https://zenodo.org/api/records/4299330/draft/pids/doi", "parent": "https://zenodo.org/api/records/4268900", "parent_html": "https://zenodo.org/records/4268900", "parent_doi": "https://doi.org/10.5281/zenodo.4268900", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.4268900", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:4299330/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:4299330/sequence/default", "files": "https://zenodo.org/api/records/4299330/files", "media_files": "https://zenodo.org/api/records/4299330/media-files", "archive": "https://zenodo.org/api/records/4299330/files-archive", "archive_media": "https://zenodo.org/api/records/4299330/media-files-archive", "latest": "https://zenodo.org/api/records/4299330/versions/latest", "latest_html": "https://zenodo.org/records/4299330/latest", "versions": "https://zenodo.org/api/records/4299330/versions", "draft": "https://zenodo.org/api/records/4299330/draft", "access_links": "https://zenodo.org/api/records/4299330/access/links", "access_grants": "https://zenodo.org/api/records/4299330/access/grants", "access_users": "https://zenodo.org/api/records/4299330/a